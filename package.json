{
  "name": "blank",
  "productName": "blank",
  "version": "1.3.8",
  "description": "A quiet, local-first agent harness for your workspace.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "blank",
  "bin": {
    "blank": "bin/blank.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "cli": "node bin/blank.js",
    "test": "node --test",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12",
    "js-yaml": "^4.3.2"
  },
  "build": {
    "appId": "dev.blank.harness",
    "productName": "blank",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "bin/**/*",
      "examples/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "purplemacaron",
        "repo": "blank"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "nsis": {
      "artifactName": "blank-Setup-${version}.${ext}"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "electron-updater": "^6.8.11",
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5",
    "ssh2": "^1.17.0"
  }
}
