{
  "name": "blank",
  "productName": "Blank",
  "version": "1.0.0",
  "description": "A quiet, local-first agent harness for your workspace.",
  "main": "electron/main.js",
  "license": "MIT",
  "author": "Blank",
  "bin": {
    "blank": "bin/blank.js"
  },
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "cli": "node bin/blank.js",
    "test": "node --test test/",
    "preview": "node scripts/preview-server.js",
    "dist": "electron-builder --publish never"
  },
  "devDependencies": {
    "electron": "^45.2.1",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "dev.blank.harness",
    "productName": "Blank",
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "bin/**/*",
      "examples/**/*",
      "assets/**/*",
      "package.json"
    ],
    "directories": {
      "output": "dist"
    },
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "assets/icon.png"
    },
    "mac": {
      "target": [
        "dmg"
      ],
      "icon": "assets/icon.png",
      "category": "public.app-category.developer-tools"
    },
    "linux": {
      "target": [
        "AppImage"
      ],
      "icon": "assets/icon.png",
      "category": "Development"
    }
  },
  "dependencies": {
    "ffmpeg-static": "^5.3.0",
    "sharp": "^0.35.5"
  }
}
